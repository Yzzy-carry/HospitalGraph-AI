# ── 联邦医院知识图谱AI · 配置模板 ──
# 用法：复制本文件为 .env 并填写；.env 已在 .gitignore 中，不会被提交。

# 数据库（MySQL 8.0）
HG_DB_HOST=localhost
HG_DB_USER=root
HG_DB_PASSWORD=你的数据库密码

# 阿里云百炼（DashScope）——用于 AI 问答与拍照识别
# 不填写也能启动：问答/拍照识别提示不可用，其余模块正常
BAILIAN_KEY=
BAILIAN_VL_MODEL=qwen3-vl-plus

# 服务绑定
HG_HOST=127.0.0.1
HG_PORT=5000
HG_DEBUG=0

# 可选：飞书通知（不填则跳过推送）
# HG_FEISHU_CONFIG=C:\path\to\openclaw.json
