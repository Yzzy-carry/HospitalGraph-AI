 "diseases": [
  {
   "id": 1,
   "name": "急性心梗",
   "icon": "",
   "dept": "心内科",
   "severity": "危急",
   "cause": "冠状动脉粥样硬化斑块破裂→血栓→冠脉急性闭塞。高危因素：高血脂、高血压、吸烟、糖尿病、肥胖、家族史。"
  },
  {
   "id": 2,
   "name": "肺炎",
   "icon": "",
   "dept": "呼吸科",
   "severity": "严重",
   "cause": "细菌/病毒/真菌感染肺部。易感：免疫力低下、长期卧床、吸烟、慢阻肺。"
  },
  {
   "id": 3,
   "name": "2型糖尿病",
   "icon": "",
   "dept": "内分泌科",
   "severity": "中度",
   "cause": "胰岛素抵抗+分泌不足。病因：遗传+肥胖+久坐+高热量饮食。"
  },
  {
   "id": 4,
   "name": "脑卒中",
   "icon": "",
   "dept": "神经内科",
   "severity": "危急",
   "cause": "脑血管破裂或堵塞→脑组织损伤。缺血性80%+出血性20%。核心危险因素：高血压、房颤。"
  },
  {
   "id": 5,
   "name": "高血压",
   "icon": "",
   "dept": "心内科",
   "severity": "轻度",
   "cause": "原发性占95%。病因：遗传+高盐+肥胖+精神应激+缺乏运动+过量饮酒。"
  },
  {
   "id": 6,
   "name": "骨折",
   "icon": "",
   "dept": "骨科",
   "severity": "中度",
   "cause": "外伤/骨质疏松→骨连续性断裂。"
  },
  {
   "id": 7,
   "name": "慢性肾病",
   "icon": "",
   "dept": "肾内科",
   "severity": "严重",
   "cause": "糖尿病肾病+高血压肾损害+慢性肾炎→肾功能进行性下降。"
  },
  {
   "id": 8,
   "name": "消化性溃疡",
   "icon": "",
   "dept": "消化内科",
   "severity": "轻度",
   "cause": "Hp感染70%+NSAIDs长期使用。胃酸和胃蛋白酶自身消化。"
  },
  {
   "id": 9,
   "name": "哮喘",
   "icon": "",
   "dept": "呼吸科",
   "severity": "中度",
   "cause": "气道慢性炎症+高反应性+可逆性气流受限。遗传过敏体质+环境过敏原。"
  }
